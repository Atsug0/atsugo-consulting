# Lien de prise de rendez-vous (Calendly), affiché dans la modale
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/atsugo-webapp/30min

# Numéro affiché publiquement : active les boutons « Appeler » (hero /domicile,
# barre mobile, footer, JSON-LD). Laisser vide = aucun bouton d'appel, le site
# retombe sur le formulaire de rappel.
NEXT_PUBLIC_PHONE=

# Lien WhatsApp optionnel, ex. https://wa.me/33612345678
NEXT_PUBLIC_WHATSAPP_URL=

# Lien « laisser un avis » de la fiche Google (affiché dans le footer et sous les avis)
NEXT_PUBLIC_REVIEW_URL=

# Profil LinkedIn affiché dans le footer
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/hugo-moulard-248890256/

# URL publique du site (SEO, sitemap)
NEXT_PUBLIC_SITE_URL=https://atsugo-consulting.vercel.app

# Code de vérification Google Search Console (balise HTML, valeur du champ content)
GOOGLE_SITE_VERIFICATION=

# Envoi des demandes du formulaire via Resend (sans clé, les demandes sont seulement journalisées)
# Ne jamais commiter la vraie clé : la mettre dans .env.local et dans les variables Vercel.
RESEND_API_KEY=
CONTACT_TO_EMAIL=atsugo.webapp@gmail.com
CONTACT_FROM_EMAIL=Atsugo Site <onboarding@resend.dev>
